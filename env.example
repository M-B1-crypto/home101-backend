# Resend — email delivery
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=requests@yourdomain.com
EMAIL_TO=owner@yourdomain.com

# Cloudflare Turnstile — get keys from dash.cloudflare.com → Turnstile
TURNSTILE_SECRET_KEY=your_secret_key_from_cloudflare

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL=https://yourdomain.com

# Invoice tool — full URL to where you host home101-invoice.html
# e.g. https://home101.vercel.app/invoice.html or a local file path
INVOICE_TOOL_URL=https://yourdomain.vercel.app/home101-invoice.html

# Invoice tool password — set this in Vercel environment variables
# The password is NEVER stored in the HTML file, only here on the server
INVOICE_PASSWORD=choose-a-strong-password-here
# (Already listed above — confirming it is required for invoice access)
# INVOICE_PASSWORD=your-secure-password
