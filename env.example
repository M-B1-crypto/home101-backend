# Resend — email delivery
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=requests@yourdomain.com
EMAIL_TO=owner@yourdomain.com

# Cloudflare Turnstile — get from dash.cloudflare.com → Turnstile
TURNSTILE_SECRET_KEY=your_secret_key_from_cloudflare

# Admin dashboard — password for /invoice login
# To generate a hashed password visit: /api/hash-password?p=YourPassword
# Then paste the $h101$... string here
INVOICE_PASSWORD=your_plain_password_or_hash

# Session signing secret — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_random_64_char_hex_string

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL=https://yourdomain.vercel.app
